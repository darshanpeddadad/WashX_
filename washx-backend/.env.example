DATABASE_URL="postgresql://postgres:password@localhost:5432/washx"

# ── Auth ──────────────────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_string_in_production"
ADMIN_KEY="washx_admin_secure_key_2024"

# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ── Razorpay ─────────────────────────────────────────
# Test keys from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_TEST_SECRET"

# ── Twilio SMS ────────────────────────────────────────
# From https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ── Email (Gmail) ─────────────────────────────────────
# Use Gmail App Password (NOT your main password)
# Enable 2FA first, then: Google Account → Security → App passwords
EMAIL_USER="washx.noreply@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
